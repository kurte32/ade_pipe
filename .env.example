# Copy to .env for local development. Every value here is a LOCAL DEVELOPMENT value.
# Production configuration is injected by Azure Container Apps from Bicep and Key Vault
# references; see infra/bicep and docs/LOCAL_DEVELOPMENT.md.

ENVIRONMENT=local            # local | test | production
LOG_LEVEL=INFO

# ---- Database (local SQL Server 2022 container) ----
SQL_SA_PASSWORD=Dev_Sa_Password_1!      # dev-only; the API never uses sa after db-init
DB_HOST=localhost
DB_PORT=1433
DB_NAME=pipeline
DB_AUTH=sql                  # sql (local) | entra (Azure, access token from managed identity)
DB_USER=pipeline_app         # least-privilege application login created by `make db-init`
DB_PASSWORD=Dev_App_Password_1!
DB_ADMIN_USER=sa             # only used by `make db-init` and migrations locally
DB_ADMIN_PASSWORD=Dev_Sa_Password_1!

# ---- Identity ----
AUTH_MODE=dev                # dev (local OIDC issuer in tools/dev-idp) | entra
AUTH_TENANT_ID=11111111-1111-4111-8111-111111111111
AUTH_AUDIENCE=22222222-2222-4222-8222-222222222222           # pipeline-api client id
AUTH_ALLOWED_AZP=33333333-3333-4333-8333-333333333333,44444444-4444-4444-8444-444444444444  # pwa, admin
AUTH_ISSUER=http://localhost:8001/11111111-1111-4111-8111-111111111111/v2.0
AUTH_JWKS_URL=http://localhost:8001/11111111-1111-4111-8111-111111111111/discovery/v2.0/keys
DEV_IDP_URL=http://localhost:8001
DEV_IDP_PUBLIC_URL=http://localhost:8001

# ---- Storage ----
STORAGE_MODE=azurite         # azurite (connection string) | azure (account URLs + managed identity)
STORAGE_BLOB_ENDPOINT=http://localhost:10000/devstoreaccount1
STORAGE_ACCOUNT_NAME=devstoreaccount1
STORAGE_ACCOUNT_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==
STORAGE_STAGING_CONTAINER=staging
STORAGE_DOCUMENTS_CONTAINER=documents
# Azure only:
STORAGE_STAGING_ACCOUNT_URL=
STORAGE_DOCUMENTS_ACCOUNT_URL=

# ---- Integrations ----
SCAN_MODE=none               # none (local, promotes without scan, refused in production) | defender
NOTIFY_MODE=log              # log (local) | graph
DIRECTORY_MODE=dev           # dev (resolve emails against dev-idp users) | graph
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
TEAMS_APP_ID=                # required when NOTIFY_MODE=graph
APP_PUBLIC_URL=http://localhost:5173

# ---- Telemetry ----
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ---- Limits (RNF-05 and TDD 9) ----
PDF_MAX_BYTES=157286400
PDF_MAX_PAGES=50
UPLOAD_CHUNK_BYTES=4194304
PHOTO_MAX_BYTES=1572864
LOAD_MAX_ROWS=5000
LOAD_MAX_BYTES=10485760
DUPLICATE_DISTANCE_METERS=15
SUSPICIOUS_NAME_WORDS=prueba,viable,equivocado,ubicacion,ubicación,test

# ---- Ports used by docker compose ----
SQL_PORT=1433
AZURITE_PORT=10000
DEV_IDP_PORT=8001
API_PORT=8000
