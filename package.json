{
  "name": "ade-pipeline",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter pwa-coordinador --filter web-admin dev",
    "build": "pnpm -r --filter './packages/**' --filter './apps/**' build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present --filter './packages/**' --filter './apps/**' test",
    "gen:api": "openapi-typescript docs/openapi.json -o packages/api-client/src/generated/schema.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^22.7.0",
    "eslint": "^9.12.0",
    "openapi-typescript": "^7.4.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0"
  }
}
